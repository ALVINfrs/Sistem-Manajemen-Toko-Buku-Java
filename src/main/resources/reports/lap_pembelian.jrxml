<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:x="http://jasperreports.sourceforge.net/xml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="lap_pembelian" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">
  <import value="java.time.format.DateTimeFormatter"/>
  <parameter name="APP_NAME" class="java.lang.String"/>
  <parameter name="PERIODE" class="java.lang.String"/>
  <field name="noFaktur" class="java.lang.String"/>
  <field name="tanggal" class="java.time.LocalDateTime"/>
  <field name="supplier" class="java.lang.String"/>
  <field name="kasir" class="java.lang.String"/>
  <field name="total" class="java.lang.Double"/>
  <variable name="TOTAL" class="java.lang.Double" calculation="Sum">
    <variableExpression><![CDATA[$F{total}]]></variableExpression>
    <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
  </variable>
  <title><band height="80">
    <textField><reportElement x="0" y="0" width="515" height="30"/><textElement textAlignment="Center"><font size="18" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{APP_NAME}]]></textFieldExpression></textField>
    <textField><reportElement x="0" y="30" width="515" height="25"/><textElement textAlignment="Center"><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["Laporan Pembelian"]]></textFieldExpression></textField>
    <textField><reportElement x="0" y="55" width="515" height="18"/><textElement textAlignment="Center"><font size="11"/></textElement><textFieldExpression><![CDATA[$P{PERIODE}]]></textFieldExpression></textField>
  </band></title>
  <columnHeader><band height="22">
    <staticText><reportElement mode="Opaque" x="0" y="0" width="110" height="22" backcolor="#000000" forecolor="#FFFFFF"/><textElement><font size="11" isBold="true"/></textElement><text><![CDATA[No. Faktur]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="110" y="0" width="110" height="22" backcolor="#000000" forecolor="#FFFFFF"/><textElement><font size="11" isBold="true"/></textElement><text><![CDATA[Tanggal]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="220" y="0" width="105" height="22" backcolor="#000000" forecolor="#FFFFFF"/><textElement><font size="11" isBold="true"/></textElement><text><![CDATA[Supplier]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="325" y="0" width="100" height="22" backcolor="#000000" forecolor="#FFFFFF"/><textElement><font size="11" isBold="true"/></textElement><text><![CDATA[Kasir]]></text></staticText>
    <staticText><reportElement mode="Opaque" x="425" y="0" width="90" height="22" backcolor="#000000" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font size="11" isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
  </band></columnHeader>
  <detail><band height="20">
    <textField><reportElement x="0" y="0" width="110" height="20"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{noFaktur}]]></textFieldExpression></textField>
    <textField><reportElement x="110" y="0" width="110" height="20"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{tanggal}.format(DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm"))]]></textFieldExpression></textField>
    <textField><reportElement x="220" y="0" width="105" height="20"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{supplier}]]></textFieldExpression></textField>
    <textField><reportElement x="325" y="0" width="100" height="20"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$F{kasir}]]></textFieldExpression></textField>
    <textField pattern="#,##0"><reportElement x="425" y="0" width="90" height="20"/><textElement textAlignment="Right"><font size="10"/></textElement><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField>
  </band></detail>
  <pageFooter><band height="20">
    <textField><reportElement x="0" y="0" width="515" height="20"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA["Halaman " + $V{PAGE_NUMBER} + " dari " + $V{PAGE_COUNT}]]></textFieldExpression></textField>
  </band></pageFooter>
  <summary><band height="24">
    <staticText><reportElement x="325" y="0" width="100" height="24"/><textElement textAlignment="Right"><font size="11" isBold="true"/></textElement><text><![CDATA[TOTAL:]]></text></staticText>
    <textField pattern="#,##0"><reportElement x="425" y="0" width="90" height="24"/><textElement textAlignment="Right"><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL}]]></textFieldExpression></textField>
  </band></summary>
</jasperReport>
